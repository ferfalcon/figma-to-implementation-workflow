{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ferfalcon/figma-to-implementation-workflow/schemas/design-workflow-config.schema.json",
  "title": "Design Workflow Project Configuration",
  "description": "Stable project identity and working boundaries shared across agents and chats.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "project",
    "repository",
    "design",
    "deployment",
    "workflow"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "implementationRoot",
        "workingBranch"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"
        },
        "implementationRoot": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?:\\.|[^/\\\\][^\\\\]*)$",
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        },
        "workingBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "url",
        "scope"
      ],
      "properties": {
        "provider": {
          "const": "figma"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(www\\.)?figma\\.com/"
        },
        "scope": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vercelProjectUrl",
        "productionUrl"
      ],
      "properties": {
        "vercelProjectUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "productionUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewStyle"
      ],
      "properties": {
        "reviewStyle": {
          "type": "string",
          "enum": [
            "brief-and-preview",
            "every-stage"
          ]
        }
      }
    }
  }
}
