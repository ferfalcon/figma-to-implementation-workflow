---
import Page from '../layouts/Page.astro';
---

<Page title="Fieldnotes — A place to start">
  <section class="hero" aria-labelledby="intro">
    <div>
      <p class="eyebrow">Space for what comes next</p>
      <h1 id="intro">A small start.<br />An open horizon.</h1>
      <p class="lede">Gather an idea, give it shape, and see where it takes you.</p>
      <button class="button" id="open-note" type="button">Open a note <span aria-hidden="true">↗</span></button>
    </div>
    <figure class="illustration">
      <img src="/horizon.svg" alt="An abstract sun rising over layered green hills" width="640" height="480" />
      <figcaption>Every good thing begins somewhere.</figcaption>
    </figure>
  </section>

  <section class="notes" aria-labelledby="notes-title">
    <h2 id="notes-title">A little room to explore</h2>
    <div class="note-grid">
      <article>
        <span class="note-number" aria-hidden="true">01</span>
        <h3>Notice the details</h3>
        <p>Simple choices bring an idea into focus.</p>
      </article>
      <article>
        <span class="note-number" aria-hidden="true">02</span>
        <h3>Follow your curiosity</h3>
        <p>Leave enough space for something unexpected.</p>
      </article>
      <article>
        <span class="note-number" aria-hidden="true">03</span>
        <h3>Make it your own</h3>
        <p>Take the next small step at your own pace.</p>
      </article>
    </div>
  </section>

  <dialog id="note-dialog" aria-labelledby="note-title">
    <div class="dialog-content">
      <p class="eyebrow">A note to begin</p>
      <h2 id="note-title">Start with one good idea.</h2>
      <p>You do not need the whole picture to take the first step.</p>
      <form method="dialog">
        <button class="button" autofocus>Close note</button>
      </form>
    </div>
  </dialog>
</Page>

<script>
  const openButton = document.querySelector<HTMLButtonElement>('#open-note');
  const dialog = document.querySelector<HTMLDialogElement>('#note-dialog');
  openButton?.addEventListener('click', () => dialog?.showModal());
  dialog?.addEventListener('close', () => openButton?.focus());
</script>
