  "architecture": {
    "stage": 6,
    "decisionRequired": true,
    "profiles": {
      "Express": {
        "requiredDecisionOutcome": "must-upgrade",
        "artifactPolicy": "never"
      },
      "Lite": {
        "requiredDecisionOutcome": "must-upgrade",
        "artifactPolicy": "never"
      },
      "Standard": {
        "requiredDecisionOutcome": "continue",
        "artifactPolicy": "required-when-required"
      },
      "Full": {
        "requiredDecisionOutcome": "continue",
        "artifactPolicy": "required"
      }
    }
  },
  "compatibility": {
    "owner": "cli/lib/contract-compatibility.mjs",
