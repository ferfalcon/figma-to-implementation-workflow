{
  "contractVersion": 2,
  "authority": {
    "machineReadable": "workflow/semantic-contract.json",
    "humanProjection": "workflow/Semantic-Contract.md",
    "projectionGenerated": true
  },
  "productModel": {
    "surface": "ordinary-chatgpt",
    "bootstrap": {
      "requiredInitialInputs": [
        {
          "id": "repository-url",
          "host": "AI-project-settings.md",
          "placeholder": "<REPOSITORY_URL>"
        }
      ],
      "startCommand": "Start the implementation workflow.",
      "localDevelopmentRequired": false
    },
    "progressiveInputs": [
      {
        "id": "figma-design",
        "requirement": "required",
        "neededBy": "design-inspection",
        "resolution": "discover-or-ask"
      },
      {
        "id": "figma-scope",
        "requirement": "required",
        "neededBy": "design-mutation",
        "resolution": "discover-or-ask"
      },
      {
        "id": "review-style",
        "requirement": "required",
        "neededBy": "workflow-initialization",
        "resolution": "ask-once"
      },
      {
        "id": "deployment",
        "requirement": "optional",
        "neededBy": "preview",
        "resolution": "discover-when-relevant"
      }
    ],
    "interactionPolicy": {
      "inferWhenSafe": true,
      "askOnlyFor": [
        "consequential-decisions",
        "missing-required-information",
        "missing-required-capabilities",
        "real-blockers"
      ]
    }
  },
  "entrypoints": [
    {
      "id": "readme",
      "path": "README.md",
      "role": "human product overview and zero-to-start instructions",
      "owns": [
        "product promise and both personas",
        "repository-url-first start",
        "maintained product scope and high-level reference map"
      ],
      "delegatesTo": [
        "QUICKSTART.md",
        "workflow/Design-Implementation-Workflow.md",
        "AGENTS-instructions.md",
        "AGENTS.md"
      ]
    },
    {
      "id": "quickstart",
      "path": "QUICKSTART.md",
      "role": "detailed first-run and resume guide",
      "owns": [
        "progressive setup and capability resolution",
        "first-run discovery and continuation behavior"
      ],
      "delegatesTo": [
        "workflow/ChatGPT-Experience.md",
        "workflow/Project-Configuration.md",
        "workflow/GitHub-Remote-Execution.md"
      ]
    },
    {
      "id": "toolkit-agents",
      "path": "AGENTS.md",
      "role": "toolkit repository agent contract",
      "owns": [
        "toolkit-maintainer agent behavior",
        "repository development and validation expectations"
      ],
      "delegatesTo": [
        "workflow/Design-Implementation-Workflow.md",
        "workflow/Validation-Rules.md"
      ]
    },
    {
      "id": "consumer-agent-bootstrap",
      "path": "AGENTS-instructions.md",
      "role": "implementation-project consumer agent bootstrap",
      "owns": [
        "minimal workflow bootstrap",
        "safety-critical agent guardrails"
      ],
      "delegatesTo": [
        "workflow/Agent-Orchestration.md",
        "workflow/State-Ownership.md",
        "workflow/GitHub-Remote-Execution.md",
        "workflow/ChatGPT-Experience.md"
      ]
    },
    {
      "id": "chatgpt-project-settings",
      "path": "AI-project-settings.md",
      "role": "ChatGPT host and tool-behavior template",
      "owns": [
        "repository bootstrap locator",
        "host boundary and immutable bootstrap loading"
      ],
      "delegatesTo": [
        "AGENTS-instructions.md",
        "workflow/Project-Configuration.md",
        "workflow/ChatGPT-Experience.md"
      ]
    },
    {
      "id": "figma-preparation-launcher",
      "path": "AGENTS-PROMPT-Figma-file-preparation.md",
      "role": "Figma preparation-only launcher",
      "owns": [
        "preparation-only launch boundary"
      ],
      "delegatesTo": [
        "source-adapters/FIGMA-PREPARATION.md"
      ]
    },
    {
      "id": "contributing",
      "path": "CONTRIBUTING.md",
      "role": "contributor guide",
      "owns": [
        "repository contribution workflow",
        "change verification expectations"
      ],
      "delegatesTo": [
        "AGENTS.md",
        "workflow/Validation-Rules.md"
      ]
    }
  ],
  "domains": [
    {
      "id": "workflow-process",
      "owner": "workflow/Design-Implementation-Workflow.md"
    },
    {
      "id": "workflow-profiles",
      "owner": "workflow/Workflow-Profiles.md"
    },
    {
      "id": "control-modes",
      "owner": "workflow/State-Ownership.md"
    },
    {
      "id": "agent-orchestration",
      "owner": "workflow/Agent-Orchestration.md"
    },
    {
      "id": "remote-execution",
      "owner": "workflow/GitHub-Remote-Execution.md"
    },
    {
      "id": "validation",
      "owner": "workflow/Validation-Rules.md"
    },
    {
      "id": "chatgpt-experience",
      "owner": "workflow/ChatGPT-Experience.md"
    },
    {
      "id": "product-acceptance",
      "owner": "workflow/Product-Acceptance.md"
    },
    {
      "id": "project-configuration",
      "owner": "workflow/Project-Configuration.md"
    }
  ],
  "controlModes": [
    {
      "id": "cli-managed",
      "executable": true,
      "canonicalState": ".workflow/workflow-record.json",
      "generatedProjectionRoot": ".workflow/generated/"
    },
    {
      "id": "markdown-only",
      "executable": false,
      "canonicalState": "narrative artifacts",
      "generatedProjectionRoot": null
    }
  ],
  "architecture": {
    "stage": 6,
    "decisionRequired": true,
    "profiles": {
      "Express": {
        "requiredDecisionOutcome": "must-upgrade",
        "artifactPolicy": "never"
      },
      "Lite": {
        "requiredDecisionOutcome": "must-upgrade",
        "artifactPolicy": "never"
      },
      "Standard": {
        "requiredDecisionOutcome": "continue",
        "artifactPolicy": "required-when-required"
      },
      "Full": {
        "requiredDecisionOutcome": "continue",
        "artifactPolicy": "required"
      }
    }
  },
  "compatibility": {
    "owner": "cli/lib/contract-compatibility.mjs",
    "humanProjection": "workflow/Contract-Compatibility.md",
    "contracts": [
      "project-configuration",
      "workflow-record",
      "orchestration-context",
      "agent-packet",
      "portable-agent-projection",
      "github-remote-command"
    ]
  }
}
